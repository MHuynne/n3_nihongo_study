APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
SESSION_SECRET=replace-with-at-least-32-random-bytes

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=n3studio
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_DATABASE=n3_study_studio
MYSQL_SSL=false
# Optional path to a custom CA certificate; omit to use system trusted roots.
# MYSQL_SSL_CA=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Single-worker default; use shared Redis/Valkey if scaling to multiple workers/instances.
RATE_LIMIT_STORAGE_URI=memory://
TRUSTED_HOSTS=["localhost","127.0.0.1"]
